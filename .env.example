# Comma-separated URLs to scrape (supports multiple pages)
JOB_BOARD_URLS=https://news.ycombinator.com/item?id=42309075

# Optional comma-separated keyword filters
INCLUDE_KEYWORDS=python,backend,remote
EXCLUDE_KEYWORDS=internship,unpaid

# Optional selectors for non-Hacker-News pages
JOB_ITEM_SELECTOR=article,li,.job,.job-card,tr
JOB_TITLE_SELECTOR=h1,h2,h3,a
JOB_COMPANY_SELECTOR=.company,.company-name,.employer,.byline
JOB_LINK_SELECTOR=a[href]

# Output Excel path
OUTPUT_FILE=job_report.xlsx

# SMTP/email settings (required unless running with --skip-email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
EMAIL_TO=recipient@example.com
